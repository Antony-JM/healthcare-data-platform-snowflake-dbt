healthcare_analytics:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'HEALTH_DATA_ENGINEER') }}"
      database: DEV_HEALTH_DB
      warehouse: HEALTH_DW_WH
      schema: STAGING
      threads: 4
      client_session_keep_alive: false
